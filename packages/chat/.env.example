# Chat Service config (design §8). Copy to .env and fill in.
# Loaded by src/env.ts via dotenv (non-overriding: pm2/test-injected vars win).

# Postgres — MUST use the chat_service role (SELECT views + CRUD chat.*, no public).
# CHAT_DATABASE_URL wins; DATABASE_URL is the fallback. Local default = the
# OrbStack `postgres` compose service on host port 5433 (bootstrap: db/sql/*).
CHAT_DATABASE_URL=postgresql://chat_service:chat_service_change_me@localhost:5433/idream
CHAT_PROJECTOR_DATABASE_URL=postgresql://chat_projector:chat_projector_change_me@localhost:5433/idream

# Redis for BullMQ queues + token streams. CHAT_REDIS_URL wins, else REDIS_URL.
CHAT_REDIS_URL=redis://127.0.0.1:6379/0
# Prefix for Chat-owned BullMQ work queues.
BULLMQ_PREFIX=idream:development

# Chat-owned relationship/evidence/boundary file projections. Scene, sessions
# and messages stay in PG; generic memory exists only in DSH/igrep.
CHAT_FS_ROOT=./data/chat

# HTTP port for chat/web (API + SSE).
CHAT_PORT=3100

# Single companion runtime. Every memory-enabled turn uses official igrep in
# the canonical DSH profile; no-memory turns use the ephemeral private profile.
DSH_AGENT_URL=http://127.0.0.1:3101
DSH_AGENT_TOKEN=replace-with-a-long-random-service-token
DSH_PROFILE_NORMAL=idream-companion-memory
DSH_PROFILE_PRIVATE=idream-companion-private
DSH_AGENT_DEADLINE_MS=300000

# BFF signing secret — MUST match main-web's CHAT_BFF_SIGNING_SECRET. Empty in
# dev/test ⇒ trust x-idream-user-id header instead of verifying a signature.
CHAT_BFF_SIGNING_SECRET=

# Internal admin API token — MUST match main/admin INTERNAL_TOKEN so the admin
# console can read chat operations data.
INTERNAL_TOKEN=replace-with-at-least-16-characters

# Chat model provider: "mock" | "openai" | "pipeline" (OpenAI-compatible endpoint).
# For local mlx, run oMLX (`omlx start`) and point at its /v1; API key is
# auth.api_key from ~/.omlx/settings.json. List models:
#   curl -H "Authorization: Bearer <key>" http://127.0.0.1:8061/v1/models
CHAT_MODEL_PROVIDER=mock
# CHAT_MODEL_BASE_URL=http://127.0.0.1:8061/v1
# CHAT_MODEL_NAME=Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-mlx-8Bit
# A companion reply is 50–200 tokens; at ~65 tok/s decode the old 8000 ceiling let
# one runaway turn hold the GPU for two minutes. 1024 keeps ~5x headroom and caps
# that at ~16s. Don't go lower: hitting the ceiling raises
# ChatModelOutputLimitError, which ends the turn rather than truncating it, so a
# long opening or a requested story would lose the whole reply.
# CHAT_MODEL_MAX_TOKENS=1024
# CHAT_MODEL_FIRST_TOKEN_TIMEOUT_MS=180000
# CHAT_MODEL_IDLE_TIMEOUT_MS=45000
# CHAT_MODEL_COMPLETE_TIMEOUT_MS=60000
# CHAT_MODEL_API_KEY=omlx
# Sampling defaults live in model-profile.ts (0.9 / 0.95 / 1.05, and 0.2 for the
# tool-planning completions) — override per host only if a model needs it.
# CHAT_MODEL_TEMPERATURE=0.9
# CHAT_MODEL_TOP_P=0.95
# CHAT_MODEL_REPETITION_PENALTY=1.05
# CHAT_MODEL_STRUCTURED_TEMPERATURE=0.2

MODERATION_PROVIDER=mock
# MODERATION_PROVIDER=safety-gateway
# MODERATION_SERVICE_URL=https://moderation.internal.example.com
# MODERATION_API_KEY=replace-with-safety-gateway-token
# MODERATION_TIMEOUT_MS=5000

# Logging: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info
