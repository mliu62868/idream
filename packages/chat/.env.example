# Chat is an execution process. Main PostgreSQL owns sessions, Turns, media
# attachments, quota and billing; Chat stores only local AgentRun evidence.

APP_ENV=development
LOG_LEVEL=info
CHAT_PORT=3100
CHAT_FS_ROOT=./data/chat

# Redis is used only for live SSE token streams. There is no Chat BullMQ queue.
CHAT_REDIS_URL=redis://127.0.0.1:6379/0

# Main receives terminal Turn commits and product ToolEffects.
MAIN_WEB_URL=http://127.0.0.1:3000
INTERNAL_TOKEN=replace-with-at-least-16-characters

# Must match Main's CHAT_BFF_SIGNING_SECRET.
CHAT_BFF_SIGNING_SECRET=replace-with-a-long-random-signing-secret

# DSH + official igrep run inside this Chat process.
DSH_AGENT_DEADLINE_MS=300000
DSH_IGREP_CANONICAL_ROOT=./data/companion-memory
DSH_IGREP_PRIVATE_ROOT=./data/companion-private
DSH_IGREP_COMMAND=igrep
DSH_IGREP_PLUGIN_URL=file:///absolute/path/to/dsh-home/profiles/idream-companion-memory/node_modules/@igrep/dsh-plugin/index.mjs
DSH_BOOTSTRAP_STATE_PATH=/absolute/path/to/dsh-home/idream-companion-bootstrap.json
IGREP_LLM_URL=http://127.0.0.1:8061/v1
IGREP_LLM_MODEL=Qwen3.5-4B-MLX-4bit
IGREP_LLM_API_KEY=replace-with-maintenance-model-token
# Optional OpenRouter routing pin; ignored by ordinary OpenAI-compatible hosts.
# DSH_OPENROUTER_PROVIDER_ONLY=DeepSeek
DSH_MAX_STEPS=8
DSH_MAX_NORMAL_AGENTS=4
DSH_MAX_PRIVATE_AGENTS=4

CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_BASE_URL=http://127.0.0.1:8061/v1
CHAT_MODEL_NAME=Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-mlx-8Bit
CHAT_MODEL_API_KEY=omlx
CHAT_MODEL_FIRST_TOKEN_TIMEOUT_MS=180000
CHAT_MODEL_IDLE_TIMEOUT_MS=45000
