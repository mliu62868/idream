# Chat is an execution process. Main PostgreSQL owns sessions, Turns, media
# attachments, quota and billing; Chat stores only local AgentRun evidence.

APP_ENV=development
LOG_LEVEL=info
CHAT_PORT=3100
CHAT_FS_ROOT=./data/chat

# Redis is used only for live SSE token streams. There is no Chat BullMQ queue.
CHAT_REDIS_URL=redis://127.0.0.1:6379/0

# Main receives terminal Turn commits and product ToolEffects.
MAIN_WEB_URL=http://127.0.0.1:3000
INTERNAL_TOKEN=replace-with-at-least-16-characters

# Must match Main's CHAT_BFF_SIGNING_SECRET.
CHAT_BFF_SIGNING_SECRET=replace-with-a-long-random-signing-secret

# Pi + provider-neutral igrep run inside this Chat process.
PI_AGENT_DEADLINE_MS=300000
PI_IGREP_CANONICAL_ROOT=./data/companion-memory
PI_IGREP_PRIVATE_ROOT=./data/companion-private
PI_IGREP_COMMAND=igrep
IGREP_LLM_URL=http://127.0.0.1:8061/v1
IGREP_LLM_MODEL=Qwen3.5-4B-MLX-4bit
IGREP_LLM_API_KEY=replace-with-maintenance-model-token
# Optional retrieval services must be bound explicitly; omitted groups are disabled.
IGREP_EMBEDDING_URL=http://127.0.0.1:8061/v1
IGREP_EMBED_MODEL=harrier-oss-v1-0.6b-MLX-8bit
IGREP_EMBEDDING_API_KEY=replace-with-embedding-model-token
IGREP_EMBED_DIM=1024
IGREP_RERANK_URL=http://127.0.0.1:8061/v1
IGREP_RERANK_MODEL=Qwen3-Reranker-0.6B-mlx-4Bit
IGREP_RERANK_API_KEY=replace-with-rerank-model-token
IGREP_RERANK_API_FORMAT=omlx
# ASK and final-sort routes use the same validated IGREP_LLM_* endpoint.
# Shared result caches and ambient web/provider routes are disabled by Chat.
# Optional OpenRouter routing pin; ignored by ordinary OpenAI-compatible hosts.
# PI_OPENROUTER_PROVIDER_ONLY=DeepSeek
PI_MAX_STEPS=8
PI_MAX_NORMAL_AGENTS=4
PI_MAX_PRIVATE_AGENTS=4

CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_BASE_URL=http://127.0.0.1:8061/v1
CHAT_MODEL_NAME=Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-mlx-8Bit
CHAT_MODEL_API_KEY=omlx
CHAT_MODEL_FIRST_TOKEN_TIMEOUT_MS=180000
CHAT_MODEL_IDLE_TIMEOUT_MS=45000

# Optional read-only public web search. Ambient IGREP web credentials never enable it.
# Supported providers: searxng, tavily, serper, exa. Omit all three to disable.
# SearXNG requires a credential-free HTTP(S) base URL; its key is optional.
# Cloud providers require the dedicated key and reject a custom URL.
# PI_IGREP_WEB_PROVIDER=searxng
# PI_IGREP_WEB_URL=https://search.example.com
# PI_IGREP_WEB_API_KEY=
