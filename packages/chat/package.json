{
  "name": "@idream/chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Companion Chat service. Main PostgreSQL owns product Turns, attachments and billing.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "bun": "1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:pure": "vitest run --config vitest.config.ts src/agent-run-store.test.ts",
    "build": "bun ../../scripts/build-bun-service.mjs src/main.ts",
    "probe:sentry": "bun src/probe-sentry.ts",
    "dev": "bun src/main.ts",
    "start": "bun dist/main.js"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@idream/shared": "workspace:*",
    "@sentry/node": "10.70.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
