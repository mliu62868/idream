# iDream chat service production environment template.
# Copy into your secret manager or deployment platform. Do not commit filled values.

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# Chat service MUST use the chat_service database role. Do not reuse main-web's
# app DATABASE_URL; chat only reads views and records chat.* domain/file intents.
CHAT_DATABASE_URL=postgresql://chat_service:replace-with-password@postgres.example.com:5432/idream

# Durable file projection completion MUST use the separate chat_projector role.
# It may complete canonical ledger intents, but cannot create or delete them.
CHAT_PROJECTOR_DATABASE_URL=postgresql://chat_projector:replace-with-password@postgres.example.com:5432/idream

# Redis for BullMQ queues and SSE token streams. Use the same Redis deployment
# as main/gen, with the shared production queue prefix.
CHAT_REDIS_URL=redis://redis.example.com:6379/0
BULLMQ_PREFIX=idream:prod

# Single-writer Chat relationship/evidence/boundary file projections. Scene,
# sessions and messages stay in PG; generic memory exists only in DSH/igrep.
CHAT_FS_ROOT=/var/lib/idream/chat

# HTTP port for chat/web (API + SSE).
CHAT_PORT=3100

# DSH + official igrep are the only companion execution and generic-memory
# authority. The process fails closed when this required sidecar is unavailable.
DSH_AGENT_URL=http://127.0.0.1:3101
DSH_AGENT_TOKEN=replace-with-a-long-random-service-token
DSH_PROFILE_NORMAL=idream-companion-memory
DSH_PROFILE_PRIVATE=idream-companion-private
DSH_AGENT_DEADLINE_MS=300000

# Must exactly match main-web's CHAT_BFF_SIGNING_SECRET.
CHAT_BFF_SIGNING_SECRET=replace-with-random-chat-bff-secret

# Must exactly match main/admin INTERNAL_TOKEN for read-only chat ops in admin.
INTERNAL_TOKEN=replace-with-random-internal-token

# Production chat model. "openai" means the internal OpenAI-compatible gateway
# accepts the tool schema used by Chat; use "pipeline" only for a gateway that
# cannot accept function-calling fields.
CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_BASE_URL=https://pipeline.internal.example.com
CHAT_MODEL_NAME=Qwen3.6-35B-A3B-uncensored-heretic-Native-MTP-Preserved-mlx-8Bit
CHAT_MODEL_FIRST_TOKEN_TIMEOUT_MS=180000
CHAT_MODEL_IDLE_TIMEOUT_MS=45000
CHAT_MODEL_COMPLETE_TIMEOUT_MS=60000
CHAT_MODEL_API_KEY=replace-with-pipeline-api-token

# Input/output moderation.
CHAT_MODERATION_PROVIDER=mock
CHAT_MODERATION_TIMEOUT_MS=5000

# Error capture.
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_RELEASE=idream@replace-with-git-sha
