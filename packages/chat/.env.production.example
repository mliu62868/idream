# Production Chat execution service. Product data and billing stay in Main PG.
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info
CHAT_PORT=3100
CHAT_FS_ROOT=/var/lib/idream/chat

# Redis is only the transient SSE stream transport.
CHAT_REDIS_URL=redis://redis.example.com:6379/0

MAIN_WEB_URL=https://app.example.com
INTERNAL_TOKEN=replace-with-random-internal-token
CHAT_BFF_SIGNING_SECRET=replace-with-random-chat-bff-secret

PI_AGENT_DEADLINE_MS=300000
PI_IGREP_CANONICAL_ROOT=/var/lib/idream/companion-memory
PI_IGREP_PRIVATE_ROOT=/var/lib/idream/companion-private
PI_IGREP_COMMAND=/usr/local/bin/igrep
IGREP_LLM_URL=https://maintenance-model.internal.example.com/v1
IGREP_LLM_MODEL=Ornith-1.5-35B-A3B-Abliterated-MLX-8bit
IGREP_LLM_API_KEY=replace-with-maintenance-model-token
# Optional retrieval services must be bound explicitly; omitted groups are disabled.
IGREP_EMBEDDING_URL=https://maintenance-model.internal.example.com/v1
IGREP_EMBED_MODEL=harrier-oss-v1-0.6b-MLX-8bit
IGREP_EMBEDDING_API_KEY=replace-with-embedding-model-token
IGREP_EMBED_DIM=1024
IGREP_RERANK_URL=https://maintenance-model.internal.example.com/v1
IGREP_RERANK_MODEL=Qwen3-Reranker-0.6B-mlx-4Bit
IGREP_RERANK_API_KEY=replace-with-rerank-model-token
IGREP_RERANK_API_FORMAT=omlx
# ASK and final-sort routes use the same validated IGREP_LLM_* endpoint.
# Shared result caches and ambient web/provider routes are disabled by Chat.
# Optional OpenRouter routing pin; omit for ordinary OpenAI-compatible hosts.
# PI_OPENROUTER_PROVIDER_ONLY=DeepSeek
PI_MAX_STEPS=8
PI_MAX_NORMAL_AGENTS=4
PI_MAX_PRIVATE_AGENTS=4

CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_BASE_URL=https://pipeline.internal.example.com
CHAT_MODEL_NAME=Ornith-1.5-35B-A3B-Abliterated-MLX-8bit
CHAT_MODEL_FIRST_TOKEN_TIMEOUT_MS=180000
CHAT_MODEL_IDLE_TIMEOUT_MS=45000
CHAT_MODEL_API_KEY=replace-with-pipeline-api-token

# Optional Chat-only image-intent judge; shares the Chat endpoint and API key.
# Omit to use only the deterministic Chinese/English matchers.
CHAT_INTENT_MODEL_NAME=Qwen3.5-4B-MLX-4bit
CHAT_INTENT_TIMEOUT_MS=2500

SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_RELEASE=idream@replace-with-git-sha

# Optional read-only public web search. Ambient IGREP web credentials never enable it.
# Supported providers: searxng, tavily, serper, exa. Omit all three to disable.
# SearXNG requires a credential-free HTTP(S) base URL; its key is optional.
# Cloud providers require the dedicated key and reject a custom URL.
# PI_IGREP_WEB_PROVIDER=searxng
# PI_IGREP_WEB_URL=https://search.example.com
# PI_IGREP_WEB_API_KEY=
