{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@idream/shared": ["../shared/src/index.ts"],
      "@idream/shared/contracts": ["../shared/src/contracts/index.ts"],
      "@idream/shared/env": ["../shared/src/contracts/env.ts"],
      "@idream/shared/bff": ["../shared/src/bff/signing.ts"],
      "@idream/shared/chat/limits": ["../shared/src/chat/limits.ts"],
      "@idream/shared/chat/companion-runtime": ["../shared/src/chat/companion-runtime.ts"],
      "@idream/shared/observability/sentry": ["../shared/src/observability/sentry.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "generated"]
}
