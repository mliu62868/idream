# Generation Service config (gen/image, gen/video). Copy to .env and fill in.
# For production, start from .env.production.example and keep filled values in
# your deployment secret manager, not in git.
# Loaded by src/env.ts via dotenv (non-overriding).

# Redis for BullMQ queues. GEN_REDIS_URL wins, else REDIS_URL.
GEN_REDIS_URL=redis://127.0.0.1:6379/0
# MUST be identical across main / chat / gen — main enqueues generation jobs that
# gen workers consume, so a different prefix means gen never sees them. Queue NAMES
# (not the prefix) isolate gen/chat/main traffic. Use idream:${APP_ENV}.
BULLMQ_PREFIX=idream:development

# Root dir the mock blob store writes generated assets under.
# Relative paths resolve from the monorepo root so main/gen share the same files.
BLOB_ROOT=data/blob

# Private generated media storage. GEN_BLOB_PROVIDER wins, else BLOB_PROVIDER.
# Production workers must use r2 or s3 so generated assets persist outside the
# worker filesystem.
GEN_BLOB_PROVIDER=mock
# BLOB_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BLOB_BUCKET=idream-private-media
# BLOB_REGION=auto
# BLOB_ACCESS_KEY_ID=replace-with-access-key
# BLOB_SECRET_ACCESS_KEY=replace-with-secret-key

# Generation adapters: `mock` or workflow-native `backend`.
GEN_IMAGE_PROVIDER=mock
GEN_VIDEO_PROVIDER=mock
GEN_MODERATION_PROVIDER=mock

# Isolated local ComfyUI runners. `bun run comfyui:start` starts both profiles:
# Image uses verified PyTorch attention on 8189; RedGraft/LTX uses its pinned
# MPSGraph recipe on 8188; MiniMax H3 uses exact PyTorch SDPA on 8190.
# COMFYUI_IMAGE_API_URL=http://127.0.0.1:8189
# COMFYUI_VIDEO_API_URL=http://127.0.0.1:8188
# COMFYUI_H3_API_URL=http://127.0.0.1:8190
# GEN_ACCELERATOR_LOCK_PATH=/tmp/idream-generation-accelerator.lock
# GEN_ACCELERATOR_LOCK_POLL_MS=1000
# Resource queue budget is independent of provider execution; default is 2 * GEN_VIDEO_TIMEOUT_MS.
# GEN_ACCELERATOR_WAIT_TIMEOUT_MS=3600000

# LTX local I2V:
# GEN_VIDEO_PROVIDER=backend
# COMFYUI_MODEL_ROOT=/Users/kk/ComfyUI-Shared/models
# GEN_IMAGE_TIMEOUT_MS=600000
# GEN_VIDEO_TIMEOUT_MS=1800000
# Comfy 源码与 Python 环境可分开；preflight 优先按源码根检查 FP8 补丁。
# COMFYUI_ROOT="/path/to/ComfyUI"
# COMFYUI_VENV_PYTHON="/path/to/video-runtime/.venv/bin/python3"

# Production moderation provider. GEN_MODERATION_PROVIDER wins, else
# MODERATION_PROVIDER. Use the same gateway main-web uses so generation input
# and output gates share policy decisions.
# GEN_MODERATION_PROVIDER=safety-gateway
# MODERATION_SERVICE_URL=https://moderation.internal.example.com
# MODERATION_API_KEY=replace-with-safety-gateway-token
# MODERATION_TIMEOUT_MS=5000

# Optional Draw Things backend. Install the official draw-things-cli, then select
# a drawthings workflow/model id from the model profile. On macOS, leaving the
# model directory unset reuses the Draw Things app's Models directory.
# DRAWTHINGS_CLI=draw-things-cli
# DRAWTHINGS_MODELS_DIR=/Users/you/Library/Containers/com.liuliu.draw-things/Data/Documents/Models
# DRAWTHINGS_OFFLINE=true
# GEN_IMAGE_INSTANCES=1  # default; increase only on a host with separate accelerators
# GEN_IMAGE_PROVIDER=backend
#
# Preflight the provider + blob boundary without touching Redis/main DB:
# bun run probe:image -- --prompt "cinematic portrait" --count 1
