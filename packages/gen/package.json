{
  "name": "@idream/gen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generation Service — gen/image + gen/video. Slow async workers: payload self-contained, write blob only, NO DB authority. Durable terminal records enter a Main-owned relay for projection.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "echo source-only",
    "start:image": "tsx src/image.ts",
    "start:video": "tsx src/video.ts",
    "probe:image": "tsx src/probe-image-pipeline.ts",
    "probe:video": "tsx src/probe-video-pipeline.ts",
    "probe:sentry": "tsx src/probe-sentry.ts",
    "probe:character-consistency": "tsx src/probe-character-consistency.ts",
    "probe:redcraft-comfyui": "tsx src/probe-redcraft-comfyui.ts",
    "sync:comfyui-workflows": "tsx src/sync-comfyui-workflows.ts",
    "smoke:backend": "tsx src/backend/smoke.ts",
    "preflight": "tsx src/preflight.ts"
  },
  "dependencies": {
    "@idream/shared": "workspace:*",
    "@sentry/node": "10.70.0",
    "bullmq": "^5.79.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
