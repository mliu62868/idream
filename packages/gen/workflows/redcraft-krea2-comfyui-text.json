{
  "id": "redcraft-krea2-comfyui-text-v1",
  "schema": "comfyui-api-prompt/v1",
  "runner": "comfyui",
  "model": {
    "unet": "redcraftKREA2RedMix_krea2Edition.safetensors",
    "clip": "qwen3vl_4b_fp8_scaled.safetensors",
    "clipType": "krea2",
    "vae": "qwen_image_vae.safetensors"
  },
  "defaults": {
    "width": 256,
    "height": 384,
    "steps": 2,
    "cfg": 1,
    "sampler": "er_sde",
    "scheduler": "simple",
    "seed": 123456789,
    "filenamePrefix": "idream_redcraft_cpu_smoke"
  },
  "notes": [
    "The embedded Redcraft metadata includes a CheckpointLoaderSimple prompt, but this local file is diffusion-only and is available through UNETLoader.",
    "Local Apple Silicon MPS fails on fp8 Float8_e4m3fn. The first successful local smoke used ComfyUI --cpu with this split-node workflow."
  ],
  "apiPrompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "redcraftKREA2RedMix_krea2Edition.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
        "type": "krea2"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_vae.safetensors"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": "{{prompt}}"
      }
    },
    "5": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": ["4", 0]
      }
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 256,
        "height": 384,
        "batch_size": 1
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0],
        "seed": 123456789,
        "steps": 2,
        "cfg": 1,
        "sampler_name": "er_sde",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["3", 0]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["8", 0],
        "filename_prefix": "idream_redcraft_cpu_smoke"
      }
    }
  }
}
