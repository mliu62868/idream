{
  "workflowKey": "qwen-image-edit-multi-reference",
  "modelId": "redcraft-multi-reference",
  "backendKind": "comfyui",
  "comfyWorkflow": {
    "id": "8bf807d5-cfc7-4fb2-90d6-774b983df93c",
    "name": "iDream · RedCraft / FineView · Identity + Source"
  },
  "version": 8,
  "negativePromptMode": "positive_instruction",
  "capabilities": [
    "img2img",
    "edit",
    "referenceImages",
    "stableSeed"
  ],
  "identity": {
    "mode": "multi_reference",
    "maxReferences": 2,
    "acceptedRoles": [
      "identity_anchor",
      "identity_reference",
      "source_image"
    ],
    "supportsLookReference": false,
    "supportsSourceImageWithIdentity": true
  },
  "quality": {
    "maxCandidates": 2,
    "evaluatorDimensions": [
      "artifact",
      "face_count",
      "identity",
      "intent"
    ]
  },
  "apiPrompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "fineview_qw21_turbo_fixed_int8.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "1:shift",
          0
        ],
        "positive": [
          "900:0",
          0
        ],
        "negative": [
          "3",
          1
        ],
        "latent_image": [
          "3",
          2
        ],
        "seed": 0,
        "steps": 6,
        "cfg": 1,
        "sampler_name": "er_sde",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "3": {
      "class_type": "IDreamQwen21TextEncode",
      "inputs": {
        "clip": [
          "4",
          0
        ],
        "vae": [
          "5",
          0
        ],
        "prompt": "",
        "negative_prompt": "",
        "resolution": 0,
        "images.image_1": [
          "9",
          0
        ],
        "images.image_2": [
          "8:scale",
          0
        ],
        "cfg": 1
      }
    },
    "4": {
      "class_type": "IDreamFreshCLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "mps"
      }
    },
    "5": {
      "class_type": "IDreamQwen21VAELoader",
      "inputs": {
        "vae_name": "texture_fix_vae_for_qwen_image_2.1_bf16.safetensors"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "9": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "12",
          0
        ],
        "upscale_method": "lanczos",
        "width": 832,
        "height": 1216,
        "crop": "disabled"
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "2",
          0
        ],
        "vae": [
          "5",
          0
        ]
      }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "10",
          0
        ],
        "filename_prefix": "idream_redcraft_multi-reference"
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "1:cache": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "1:resident",
          0
        ],
        "device": "auto",
        "dtype": "default"
      }
    },
    "8:scale": {
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": [
          "8",
          0
        ],
        "upscale_method": "lanczos",
        "megapixels": 1,
        "resolution_steps": 32
      }
    },
    "900:0": {
      "class_type": "IDreamUnloadOffDeviceModels",
      "inputs": {
        "passthrough": [
          "3",
          0
        ],
        "after": [
          "3",
          1
        ],
        "release": [
          "4",
          0
        ]
      }
    },
    "1:resident": {
      "class_type": "IDreamQwen21ResidentWeights",
      "inputs": {
        "model": [
          "1",
          0
        ]
      }
    },
    "1:shift": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1:cache",
          0
        ],
        "shift": 1.31,
        "sampling": "flow"
      }
    }
  },
  "inputs": [
    {
      "key": "prompt",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "prompt"
      }
    },
    {
      "key": "negative",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "negative_prompt"
      },
      "default": ""
    },
    {
      "key": "identity_image",
      "type": "image",
      "referenceRoles": [
        "identity_anchor",
        "identity_reference"
      ],
      "target": {
        "nodeId": "8",
        "field": "image"
      }
    },
    {
      "key": "source_image",
      "type": "image",
      "referenceRoles": [
        "source_image"
      ],
      "target": {
        "nodeId": "12",
        "field": "image"
      }
    },
    {
      "key": "width",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "width"
      },
      "default": 832
    },
    {
      "key": "height",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "height"
      },
      "default": 1216
    },
    {
      "key": "seed",
      "type": "int",
      "target": {
        "nodeId": "2",
        "field": "seed"
      }
    },
    {
      "key": "steps",
      "type": "int",
      "target": {
        "nodeId": "2",
        "field": "steps"
      },
      "default": 6
    }
  ]
}
