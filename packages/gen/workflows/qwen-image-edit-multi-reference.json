{
  "workflowKey": "qwen-image-edit-multi-reference",
  "modelId": "redqw21-multi-reference",
  "backendKind": "comfyui",
  "comfyWorkflow": {
    "id": "8bf807d5-cfc7-4fb2-90d6-774b983df93c",
    "name": "iDream \u00b7 REDQW21 V2 \u00b7 Identity + Source"
  },
  "version": 7,
  "negativePromptMode": "positive_instruction",
  "capabilities": [
    "img2img",
    "edit",
    "referenceImages",
    "stableSeed"
  ],
  "identity": {
    "mode": "multi_reference",
    "maxReferences": 2,
    "acceptedRoles": [
      "identity_anchor",
      "identity_reference",
      "source_image"
    ],
    "supportsLookReference": false,
    "supportsSourceImageWithIdentity": true
  },
  "quality": {
    "maxCandidates": 2,
    "evaluatorDimensions": [
      "artifact",
      "face_count",
      "identity",
      "intent"
    ]
  },
  "apiPrompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "redqw21_unlocked_v2_bf16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "2:noise",
          0
        ],
        "guider": [
          "2:guider",
          0
        ],
        "sampler": [
          "2:sampler",
          0
        ],
        "sigmas": [
          "2:sigmas",
          0
        ],
        "latent_image": [
          "3",
          2
        ]
      }
    },
    "3": {
      "class_type": "IDreamQwen21TextEncode",
      "inputs": {
        "clip": [
          "4",
          0
        ],
        "vae": [
          "5",
          0
        ],
        "prompt": "",
        "negative_prompt": "",
        "resolution": 0,
        "images.image_1": [
          "9",
          0
        ],
        "images.image_2": [
          "8:scale",
          0
        ],
        "cfg": 1
      }
    },
    "4": {
      "class_type": "IDreamFreshCLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "mps"
      }
    },
    "5": {
      "class_type": "IDreamQwen21VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "9": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "12",
          0
        ],
        "upscale_method": "lanczos",
        "width": 832,
        "height": 1216,
        "crop": "disabled"
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "2",
          0
        ],
        "vae": [
          "5",
          0
        ]
      }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "10",
          0
        ],
        "filename_prefix": "idream_redqw21_v2_multi-reference"
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "1:cache": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "device": "auto",
        "dtype": "default"
      }
    },
    "8:scale": {
      "class_type": "ImageScaleToTotalPixels",
      "inputs": {
        "image": [
          "8",
          0
        ],
        "upscale_method": "lanczos",
        "megapixels": 1,
        "resolution_steps": 32
      }
    },
    "900:0": {
      "class_type": "IDreamUnloadOffDeviceModels",
      "inputs": {
        "passthrough": [
          "3",
          0
        ],
        "after": [
          "3",
          1
        ],
        "release": [
          "4",
          0
        ]
      }
    },
    "1:lora": {
      "class_type": "IDreamQwen21TurboLora",
      "inputs": {
        "model": [
          "1:cache",
          0
        ],
        "lora_name": "Qwen-Image-2.1-viggle-turbo-v0.3-6step-lora-r128.safetensors"
      }
    },
    "2:noise": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 0
      }
    },
    "2:guider": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "1:lora",
          0
        ],
        "conditioning": [
          "900:0",
          0
        ]
      }
    },
    "2:sampler": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "2:sigmas": {
      "class_type": "IDreamQwen21TurboSigmas",
      "inputs": {
        "latent": [
          "3",
          2
        ],
        "steps": 6
      }
    }
  },
  "inputs": [
    {
      "key": "prompt",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "prompt"
      }
    },
    {
      "key": "negative",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "negative_prompt"
      },
      "default": ""
    },
    {
      "key": "identity_image",
      "type": "image",
      "referenceRoles": [
        "identity_anchor",
        "identity_reference"
      ],
      "target": {
        "nodeId": "8",
        "field": "image"
      }
    },
    {
      "key": "source_image",
      "type": "image",
      "referenceRoles": [
        "source_image"
      ],
      "target": {
        "nodeId": "12",
        "field": "image"
      }
    },
    {
      "key": "width",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "width"
      },
      "default": 832
    },
    {
      "key": "height",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "height"
      },
      "default": 1216
    },
    {
      "key": "seed",
      "type": "int",
      "target": {
        "nodeId": "2:noise",
        "field": "noise_seed"
      }
    },
    {
      "key": "steps",
      "type": "int",
      "target": {
        "nodeId": "2:sigmas",
        "field": "steps"
      },
      "default": 6
    }
  ]
}
