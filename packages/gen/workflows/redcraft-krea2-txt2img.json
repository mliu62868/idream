{
  "workflowKey": "redcraft-krea2-txt2img",
  "modelId": "redcraft-krea2-comfyui",
  "backendKind": "comfyui",
  "version": 1,
  "capabilities": ["textToImage", "stableSeed"],
  "apiPrompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "redcraftKREA2RedMix_krea2Edition-bf16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_4b_bf16.safetensors",
        "type": "krea2"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_vae.safetensors"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["2", 0],
        "text": ""
      }
    },
    "5": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": ["4", 0]
      }
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 832,
        "height": 1216,
        "batch_size": 1
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0],
        "seed": 0,
        "steps": 10,
        "cfg": 1,
        "sampler_name": "er_sde",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["3", 0]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["8", 0],
        "filename_prefix": "idream_redcraft"
      }
    }
  },
  "inputs": [
    { "key": "prompt", "type": "text", "target": { "nodeId": "4", "field": "text" } },
    { "key": "width", "type": "int", "target": { "nodeId": "6", "field": "width" }, "default": 832 },
    { "key": "height", "type": "int", "target": { "nodeId": "6", "field": "height" }, "default": 1216 },
    { "key": "seed", "type": "int", "target": { "nodeId": "7", "field": "seed" } },
    { "key": "steps", "type": "int", "target": { "nodeId": "7", "field": "steps" }, "default": 10 }
  ]
}
