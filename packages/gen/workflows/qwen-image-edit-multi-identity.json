    },
    {
      "key": "height",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "height"
      },
      "default": 1216
    },
    {
      "key": "seed",
      "type": "int",
      "target": {
        "nodeId": "2",
        "field": "seed"
      }
    },
    {
      "key": "steps",
      "type": "int",
      "target": {
        "nodeId": "2",
        "field": "steps"
      },
      "default": 4
