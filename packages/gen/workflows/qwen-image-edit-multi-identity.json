{
  "workflowKey": "qwen-image-edit-multi-identity",
  "modelId": "redqw21-multi-identity",
  "backendKind": "comfyui",
  "comfyWorkflow": {
    "id": "ffb4dcad-aa2c-4604-8f8f-e03a86078d81",
    "name": "iDream \u00b7 REDQW21 V2 \u00b7 Multi-Reference Identity"
  },
  "version": 5,
  "negativePromptMode": "positive_instruction",
  "capabilities": [
    "img2img",
    "edit",
    "referenceImages",
    "stableSeed"
  ],
  "identity": {
    "mode": "multi_identity",
    "maxReferences": 2,
    "acceptedRoles": [
      "identity_anchor",
      "identity_reference",
      "look_reference"
    ],
    "supportsLookReference": true,
    "supportsSourceImageWithIdentity": false
  },
  "quality": {
    "maxCandidates": 2,
    "evaluatorDimensions": [
      "artifact",
      "face_count",
      "identity",
      "intent"
    ]
  },
  "apiPrompt": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "redqw21_unlocked_v2_bf16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "1:cache",
          0
        ],
        "positive": [
          "900:0",
          0
        ],
        "negative": [
          "900:0",
          1
        ],
        "latent_image": [
          "9",
          0
        ],
        "seed": 0,
        "steps": 16,
        "cfg": 2,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "3": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": [
          "4",
          0
        ],
        "vae": [
          "5",
          0
        ],
        "prompt": "",
        "negative_prompt": "",
        "resolution": 1024,
        "images.image_1": [
          "8",
          0
        ],
        "images.image_2": [
          "12",
          0
        ]
      }
    },
    "4": {
      "class_type": "IDreamFreshCLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image",
        "device": "cpu"
      }
    },
    "5": {
      "class_type": "IDreamQwen21VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "9": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 832,
        "height": 1216,
        "batch_size": 1
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "2",
          0
        ],
        "vae": [
          "5",
          0
        ]
      }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "10",
          0
        ],
        "filename_prefix": "idream_redqw21_v2_multi-identity"
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "1:cache": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "device": "auto",
        "dtype": "default"
      }
    },
    "900:0": {
      "class_type": "IDreamUnloadOffDeviceModels",
      "inputs": {
        "passthrough": [
          "3",
          0
        ],
        "after": [
          "3",
          1
        ],
        "release": [
          "4",
          0
        ]
      }
    }
  },
  "inputs": [
    {
      "key": "prompt",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "prompt"
      }
    },
    {
      "key": "negative",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "negative_prompt"
      },
      "default": ""
    },
    {
      "key": "identity_anchor",
      "type": "image",
      "required": true,
      "referenceRoles": [
        "identity_anchor"
      ],
      "target": {
        "nodeId": "8",
        "field": "image"
      }
    },
    {
      "key": "identity_reference",
      "type": "image",
      "required": true,
      "referenceRoles": [
        "identity_reference",
        "look_reference"
      ],
      "target": {
        "nodeId": "12",
        "field": "image"
      }
    },
    {
      "key": "width",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "width"
      },
      "default": 832
    },
    {
      "key": "height",
      "type": "int",
      "target": {
        "nodeId": "9",
        "field": "height"
      },
      "default": 1216
    },
    {
      "key": "seed",
      "type": "int",
      "target": {
        "nodeId": "2",
        "field": "seed"
      }
    },
    {
      "key": "steps",
      "type": "int",
      "target": {
        "nodeId": "2",
        "field": "steps"
      },
      "default": 16
    }
  ]
}
