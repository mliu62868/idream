      "artifact",
      "face_count",
      "identity",
      "intent"
    ]
  },
  "apiPrompt": {
    "1": {
      "class_type": "CheckpointLoaderKJ",
      "inputs": {
        "ckpt_name": "Qwen-Rapid-AIO-NSFW-v19.safetensors",
        "weight_dtype": "fp8_e4m3fn",
        "compute_dtype": "default",
        "patch_cublaslinear": false,
        "sage_attention": "disabled",
        "enable_fp16_accumulation": false
      }
    },
    "2": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "positive": [
          "3",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "latent_image": [
          "9",
          0
        ],
        "seed": 0,
        "steps": 4,
        "cfg": 1,
        "sampler_name": "sa_solver",
        "scheduler": "beta",
        "denoise": 1
      }
    },
    "3": {
      "class_type": "TextEncodeQwenImageEditPlus",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "vae": [
          "1",
          2
        ],
        "image1": [
          "8",
          0
        ],
        "image2": [
          "12",
          0
        ],
        "prompt": ""
      }
    },
    "4": {
      "class_type": "TextEncodeQwenImageEditPlus",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "prompt": ""
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "9": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 832,
        "height": 1216,
        "batch_size": 1
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "2",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "11": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "10",
          0
        ],
        "filename_prefix": "idream_qwen_edit_multi_identity"
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    }
  },
  "inputs": [
    {
      "key": "prompt",
      "type": "text",
      "target": {
        "nodeId": "3",
        "field": "prompt"
      }
    },
    {
      "key": "negative",
      "type": "text",
      "target": {
        "nodeId": "4",
        "field": "prompt"
      },
