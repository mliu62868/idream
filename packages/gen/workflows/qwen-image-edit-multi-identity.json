{
  "workflowKey": "qwen-image-edit-multi-identity",
  "modelId": "qwen-image-edit-multi-identity",
  "backendKind": "comfyui",
  "comfyWorkflow": {
    "id": "ffb4dcad-aa2c-4604-8f8f-e03a86078d81",
    "name": "iDream · Qwen Image Edit · Two Identity References"
  },
  "version": 1,
  "capabilities": [
    "img2img",
    "edit",
    "referenceImages",
    "stableSeed"
