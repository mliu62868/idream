{
  "name": "@idream/main",
  "version": "0.3.1",
  "private": true,
  "description": "iDream main web application and core-domain API.",
  "license": "MIT",
  "keywords": [
    "idream",
    "ai-companion",
    "nextjs",
    "prisma",
    "postgresql"
  ],
  "engines": {
    "node": ">=22",
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun scripts/start-development.cjs",
    "build": "bun run db:generate && bun run build:workers && bun ../../scripts/build-next-standalone.mjs packages/main",
    "build:workers": "bun ../../scripts/build-bun-service.mjs src/processes/finalizer.ts src/processes/event-consumer.ts src/processes/admin-command-worker.ts",
    "start": "bun --bun next start",
    "lint": "eslint",
    "typecheck": "bun run db:generate && bun --bun next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run build",
    "check:launch": "bun src/server/launch-readiness.ts",
    "check:migration-authority": "bun src/scripts/check-migration-authority.ts",
    "check:generation-cutover": "bun src/scripts/check-generation-dispatch-cutover.ts",
    "recovery:rehearse": "bun src/scripts/create-recovery-rehearsal-bundle.ts",
    "generation-cutover:acknowledge-failed-source-residue": "bun src/scripts/acknowledge-generation-failed-source-residue.ts",
    "generation-cutover:pause-and-drain": "bun src/scripts/control-generation-cutover-queues.ts pause-and-drain",
    "generation-cutover:resume": "bun src/scripts/control-generation-cutover-queues.ts resume",
    "test": "vitest run",
    "test:pure": "vitest run --config vitest.pure.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "PW_WEBSERVER=1 playwright test",
    "db:generate": "bun --bun prisma generate",
    "db:push": "node scripts/db-push.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "db:studio": "prisma studio",
    "start:finalizer": "bun dist/finalizer.js",
    "start:event-consumer": "bun dist/event-consumer.js",
    "start:admin-command-worker": "bun dist/admin-command-worker.js",
    "admin:backfill:characters": "tsx src/processes/admin-character-backfill.ts",
    "admin:backfill:operations": "tsx src/processes/admin-production-backfill.ts",
    "admin:backfill:generation-attempt-events": "tsx src/processes/generation-attempt-event-backfill.ts",
    "admin:repair:editorial-visual-identities": "tsx src/scripts/repair-editorial-visual-identities.ts",
    "character-soul:import": "tsx src/scripts/import-character-soul.ts",
    "character-soul:audit": "tsx src/scripts/audit-character-soul-authority.ts",
    "metrics:backfill": "tsx src/scripts/metrics-backfill.ts",
    "metrics:refresh": "tsx src/scripts/metrics-refresh.ts",
    "generation:diagnostics": "tsx src/scripts/generation-diagnostics.ts",
    "admin:readiness:load": "tsx src/scripts/admin-production-like-readiness.ts",
    "admin:readiness:migrations": "node scripts/admin-migration-rehearsal.mjs",
    "admin:readiness:shadow": "tsx src/scripts/admin-shadow-report.ts",
    "admin:readiness:release-gate": "tsx src/scripts/admin-release-gate.ts",
    "admin:readiness:sign": "tsx src/scripts/admin-release-sign.ts",
    "admin:readiness:canary": "tsx src/scripts/admin-canary.ts",
    "admin:readiness:chaos": "tsx src/scripts/admin-dependency-chaos.ts",
    "admin:readiness:chaos:real-projector": "RUN_ADMIN_REAL_PROCESS_CHAOS=1 vitest run src/server/readiness/real-projector-process-chaos.test.ts --reporter=verbose",
    "admin:readiness:chaos:real-command-worker": "RUN_ADMIN_REAL_COMMAND_WORKER_CHAOS=1 vitest run src/server/readiness/real-command-worker-process-chaos.test.ts --reporter=verbose",
    "probe:age": "tsx src/server/probe-age-verification.ts",
    "probe:blob": "tsx src/server/probe-blob-storage.ts",
    "probe:catalog": "tsx src/server/probe-public-catalog.ts",
    "cleanup:public-content": "tsx src/server/cleanup-public-content.ts",
    "diagnose:chat-provider": "tsx src/server/probe-chat-model.ts",
    "probe:admin-text": "tsx src/server/probe-admin-text.ts",
    "probe:chat-service": "tsx src/server/probe-chat-service.ts",
    "quality:characters": "tsx src/scripts/character-quality/run.ts",
    "probe:generation-model-candidates": "tsx src/server/probe-generation-model-candidates.ts",
    "probe:generation-persistence": "tsx src/server/probe-generation-persistence.ts",
    "probe:payment": "tsx src/server/probe-payment-provider.ts",
    "probe:product-config": "tsx src/server/probe-product-config.ts",
    "probe:safety": "tsx src/server/probe-safety-gateway.ts",
    "probe:sentry": "tsx src/server/probe-sentry.ts",
    "probe:web-surface": "tsx src/server/probe-web-surface.ts",
    "probe:voice": "tsx src/server/probe-voice-model.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@idream/shared": "workspace:*",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "@sentry/nextjs": "10.70.0",
    "better-auth": "^1.6.18",
    "bullmq": "^5.79.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@prisma/engines": "7.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "7.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
