// Shape SSoT. Main web is Postgres-only.
// The datasource URL is provided by prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  displayName   String?
  role          String    @default("user") // enum: user | moderator | support | ops | analyst | admin
  status        String    @default("active") // enum: active | suspended | deleted
  dataClass     String    @default("customer") // enum: customer | internal | fixture | audit
  anonymousId   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions           Session[]
  accounts           Account[]
  preferences        UserPreferences?
  ageGateAcceptances AgeGateAcceptance[]
  ageVerifications   AgeVerification[]
  charactersCreated  Character[]              @relation("CharacterCreator")
  characterDrafts    CharacterDraft[]
  recentChats        RecentChat[]
  generationJobs     GenerationJob[]
  mediaAssets        MediaAsset[]
  voiceClipRequests  VoiceClipRequest[]
  voiceUsageFacts    VoiceUsageFact[]
  productionBatches  ContentProductionBatch[]
  mediaPlacements    MediaAssetPlacement[]
  mediaLikes         MediaLike[]
  characterLikes     CharacterLike[]
  mediaCollections   MediaCollection[]
  presets            GenerationPreset[]
  subscriptions      Subscription[]
  entitlements       Entitlement[]
  ledgerEntries      DreamcoinLedger[]
  checkoutSessions   CheckoutSession[]
  redemptions        RedeemCodeRedemption[]
  referralsSent      Referral[]               @relation("Inviter")
  referralsReceived  Referral[]               @relation("Invitee")
  reportsMade        ContentReport[]          @relation("Reporter")
  appeals            Appeal[]
  supportRequests    SupportRequest[]         @relation("SupportRequester")
  assignedSupport    SupportRequest[]         @relation("SupportAssignee")
  feedbackItems      ProductFeedbackItem[]    @relation("FeedbackCreator")
  feedbackVotes      ProductFeedbackVote[]
  followers          Follow[]                 @relation("Followee")
  following          Follow[]                 @relation("Follower")
  characterLooks     CharacterLook[]
  generationFeedback GenerationFeedback[]

  @@index([dataClass, status, deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  providerId           String // enum: credential | google | discord | ...
  accountId            String
  password             String?
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  scope                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("verifications")
}

model UserPreferences {
  userId               String   @id
  mutedTags            Json
  safeModeFlags        Json
  notificationSettings Json
  locale               String   @default("en")
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model AgeGateAcceptance {
  id            String   @id @default(cuid())
  userId        String?
  anonymousId   String?
  acceptedAt    DateTime @default(now())
  country       String?
  sourcePath    String?
  policyVersion String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@map("age_gate_acceptances")
}

model AgeVerification {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String // enum: gocam | yoti | persona | veriff | mock
  providerVerificationId String?
  status                 String    @default("required") // enum: required | pending | verified | failed | expired | not_required
  jurisdiction           String?
  requiredReason         String?
  verifiedAt             DateTime?
  expiresAt              DateTime?
  metadata               Json
  createdAt              DateTime  @default(now())
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("age_verifications")
}

model Character {
  id              String    @id @default(cuid())
  creatorId       String?
  name            String
  age             Int
  description     String
  systemPrompt    String?
  visibility      String    @default("private") // enum: private | unlisted | public
  status          String    @default("draft") // enum: draft | pending_review | approved | rejected | removed | archived
  source          String    @default("user") // enum: official | user — 官方角色由 admin CMS 生产，跳过用户审核但仍过 moderation
  style           String    @default("realistic") // enum: realistic | anime | hybrid | other
  gender          String    @default("female") // enum: female | male | trans
  relationship    String?
  voiceId         String?
  imageAssetId    String?
  appearance      Json
  advancedDetails Json
  vivid           Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  creator           User?                    @relation("CharacterCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  imageAsset        MediaAsset?              @relation("CharacterImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  tags              CharacterTag[]
  stats             CharacterStats?
  submissions       CharacterSubmission[]
  recentChats       RecentChat[]
  generationJobs    GenerationJob[]
  mediaAssets       MediaAsset[]             @relation("CharacterAssets")
  voiceClipRequests VoiceClipRequest[]
  voiceUsageFacts   VoiceUsageFact[]
  visualProfiles    CharacterVisualProfile[]
  looks             CharacterLook[]
  voiceProfiles     CharacterVoiceProfile[]
  likes             CharacterLike[]
  serving           CharacterServing?

  @@index([visibility, status])
  @@index([source, visibility, status])
  @@index([creatorId])
  @@index([gender, style])
  @@index([createdAt])
  @@map("characters")
}

model CharacterVoiceProfile {
  id               String      @id @default(cuid())
  characterId      String
  version          Int
  provider         String      @default("fish_audio")
  providerVoiceId  String      @unique
  model            String
  language         String
  deliverySettings Json        @default("{}")
  status           String      @default("candidate") // enum: candidate | active | archived | failed
  referenceAssetId String
  previewAssetId   String?
  sampleText       String
  createdById      String
  createdAt        DateTime    @default(now())
  archivedAt       DateTime?
  character        Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  referenceAsset   MediaAsset  @relation("VoiceReferenceAsset", fields: [referenceAssetId], references: [id], onDelete: Restrict)
  previewAsset     MediaAsset? @relation("VoicePreviewAsset", fields: [previewAssetId], references: [id], onDelete: SetNull)

  @@unique([characterId, version])
  @@index([characterId, status, version])
  @@map("character_voice_profiles")
}

model VoiceClipRequest {
  id                 String           @id
  userId             String
  characterId        String
  messageId          String
  requestFingerprint String
  synthesisPayload   Json?
  providerPayload    Json
  status             String           @default("running") // enum: running | succeeded | failed | skipped
  attemptNo          Int              @default(1)
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  mediaAssetId       String?
  provider           String?
  providerRequestId  String?
  errorCode          String?
  error              Json?
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  character          Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset?      @relation("VoiceClipRequestMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  usageFacts         VoiceUsageFact[]

  @@unique([userId, messageId])
  @@index([status, leaseExpiresAt])
  @@index([characterId, createdAt])
  @@map("voice_clip_requests")
}

model VoiceUsageFact {
  id             String           @id
  requestId      String
  attemptNo      Int
  userId         String
  characterId    String
  mediaAssetId   String?
  durationMs     Int
  costDreamcoins Int
  intent         String
  occurredAt     DateTime         @default(now())
  request        VoiceClipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  character      Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?      @relation("VoiceUsageMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([requestId, attemptNo])
  @@index([userId, occurredAt])
  @@index([characterId, occurredAt])
  @@map("voice_usage_facts")
}

model CharacterDraft {
  id              String                @id @default(cuid())
  ownerId         String
  step            Int                   @default(0)
  gender          String?
  style           String?
  appearance      Json
  hair            Json
  body            Json
  name            String?
  advancedDetails Json
  tags            Json
  previewJobId    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  previewJobs     CharacterPreviewJob[]

  @@index([ownerId])
  @@map("character_drafts")
}

model CharacterPreviewJob {
  id            String         @id @default(cuid())
  draftId       String
  status        String         @default("queued") // enum: queued | running | completed | failed
  provider      String?
  resultAssetId String?
  errorCode     String?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
  draft         CharacterDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("character_preview_jobs")
}

model CharacterVisualProfile {
  id                     String                 @id @default(cuid())
  characterId            String
  version                Int                    @default(1)
  status                 String                 @default("draft") // enum: draft | active | archived
  style                  String                 @default("realistic")
  identityPrompt         String
  negativeIdentityPrompt String?
  faceTraits             Json
  hairTraits             Json
  bodyTraits             Json
  signatureTraits        Json
  styleTraits            Json
  anchorAssetIds         Json
  defaultSeed            String?
  adapterRefs            Json
  qualityScore           Float?
  consistencyScore       Float?
  immutableHash          String?
  evidenceState          String                 @default("legacy_candidate")
  createdFrom            String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  character              Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  referenceSetRevisions  ReferenceSetRevision[]
  looks                  CharacterLook[]
  referenceCandidates    ReferenceCandidate[]

  @@unique([characterId, version])
  @@index([characterId, status])
  @@map("character_visual_profiles")
}

model CharacterLook {
  id                String                 @id @default(cuid())
  characterId       String
  visualProfileId   String
  ownerId           String
  label             String
  appearanceDelta   Json
  referenceAssetId  String?
  status            String                 @default("active") // enum: active | archived | needs_rebase
  activeKey         String?                @unique
  rebasedFromLookId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  character         Character              @relation(fields: [characterId], references: [id], onDelete: Cascade)
  visualProfile     CharacterVisualProfile @relation(fields: [visualProfileId], references: [id], onDelete: Restrict)
  owner             User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  referenceAsset    MediaAsset?            @relation(fields: [referenceAssetId], references: [id], onDelete: SetNull)
  rebasedFromLook   CharacterLook?         @relation("LookRebase", fields: [rebasedFromLookId], references: [id], onDelete: SetNull)
  rebasedLooks      CharacterLook[]        @relation("LookRebase")
  generationJobs    GenerationJob[]

  @@index([ownerId, characterId, status])
  @@index([visualProfileId])
  @@index([referenceAssetId])
  @@map("character_looks")
}

model ReferenceSetRevision {
  id                  String                             @id @default(cuid())
  visualProfileId     String
  revision            Int                                @default(1)
  status              String                             @default("active") // enum: active | superseded
  selectorVersion     String                             @default("v1")
  createdFrom         String
  availableAtSnapshot DateTime                           @default(now())
  snapshotHash        String?
  createdAt           DateTime                           @default(now())
  visualProfile       CharacterVisualProfile             @relation(fields: [visualProfileId], references: [id], onDelete: Cascade)
  references          CharacterVisualReferenceSnapshot[]
  generationJobs      GenerationJob[]
  promotedCandidates  ReferenceCandidate[]

  @@unique([visualProfileId, revision])
  @@index([visualProfileId, status])
  @@map("reference_set_revisions")
}

model ReferenceCandidate {
  id                 String                 @id @default(cuid())
  visualProfileId    String
  mediaAssetId       String
  sourceJobId        String?
  proposedRole       String                 @default("identity_reference")
  qualityScore       Float?
  identityScore      Float?
  source             String
  status             String                 @default("candidate") // enum: candidate | rejected | promoted
  rejectionReason    String?
  promotedRevisionId String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  visualProfile      CharacterVisualProfile @relation(fields: [visualProfileId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  sourceJob          GenerationJob?         @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  promotedRevision   ReferenceSetRevision?  @relation(fields: [promotedRevisionId], references: [id], onDelete: SetNull)

  @@unique([visualProfileId, mediaAssetId])
  @@index([visualProfileId, status])
  @@index([sourceJobId])
  @@index([promotedRevisionId])
  @@map("reference_candidates")
}

model CharacterVisualReferenceSnapshot {
  id                     String               @id @default(cuid())
  referenceSetRevisionId String
  mediaAssetId           String
  position               Int
  role                   String // enum: primary_face | identity_anchor | identity_reference
  weight                 Float                @default(1)
  crop                   Json?
  qualityScore           Float?
  identityScore          Float?
  selectorVersion        String               @default("v1")
  selectionReason        String
  createdAt              DateTime             @default(now())
  referenceSetRevision   ReferenceSetRevision @relation(fields: [referenceSetRevisionId], references: [id], onDelete: Cascade)
  mediaAsset             MediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([referenceSetRevisionId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("character_visual_reference_snapshots")
}

model Tag {
  id               String         @id @default(cuid())
  slug             String         @unique
  label            String
  category         String?
  isSensitive      Boolean        @default(false)
  isMutedByDefault Boolean        @default(false)
  characters       CharacterTag[]

  @@index([category])
  @@map("tags")
}

model CharacterTag {
  characterId String
  tagId       String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
  @@index([tagId])
  @@map("character_tags")
}

model CharacterStats {
  characterId    String    @id
  likesCount     Int       @default(0)
  chatsCount     Int       @default(0)
  viewsCount     Int       @default(0)
  lastActivityAt DateTime?
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([likesCount])
  @@index([chatsCount])
  @@map("character_stats")
}

model CharacterLike {
  userId      String
  characterId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
  @@map("character_likes")
}

model CharacterSubmission {
  id           String    @id @default(cuid())
  characterId  String
  submitterId  String
  status       String    @default("pending") // enum: pending | approved | rejected
  reviewReason String?
  reviewerId   String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([characterId])
  @@map("character_submissions")
}

// 角色创建模板（admin 维护的脚手架）。模板 = 一组预填值，用户选用后灌进 CharacterDraft，
// 选完即脱钩，与已建角色无运行时关联（不做继承/版本化，见 CHARACTER_MANAGEMENT_PLAN §1）。
model CharacterTemplate {
  id              String   @id @default(cuid())
  scope           String   @default("built_in") // enum: built_in | community
  name            String
  summary         String?
  gender          String?
  style           String?
  appearance      Json
  advancedDetails Json
  tags            Json // string[]
  coverAssetId    String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coverAsset MediaAsset? @relation("TemplateCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@map("character_templates")
}

// Recent-chats read projection (main-owned). The chat service is the authority
// for chat sessions/messages (its own chat.* schema); main keeps this lean
// projection fed by the chat→main outbox (session.created / message.completed /
// session.deleted) so the library "recent" tab works without main writing the
// chat domain. One-way derived from events — never the source of truth.
model RecentChat {
  sessionId     String    @id
  userId        String
  characterId   String
  title         String?
  status        String    @default("active") // active | deleted
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt])
  @@index([characterId])
  @@map("recent_chats")
}

model GenerationPreset {
  id         String   @id @default(cuid())
  ownerId    String?
  scope      String   @default("user") // enum: built_in | user | community
  type       String // enum: background | pose | outfit | mode
  category   String?
  label      String
  controls   Json
  visibility String   @default("private") // enum: private | public | unlisted
  status     String   @default("active") // enum: active | archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([scope, type])
  @@index([ownerId])
  @@map("generation_presets")
}

model GenerationJob {
  id                     String                  @id @default(cuid())
  userId                 String
  characterId            String?
  visualProfileId        String?
  visualProfileVersion   Int?
  consistencyMode        String?
  seed                   String?
  referenceAssetIds      Json?
  referenceSetRevisionId String?
  referenceManifest      Json?
  momentSpec             Json?
  lookId                 String?
  lookSnapshot           Json?
  derivedFromJobId       String?
  idempotencyKey         String?
  mode                   String // enum: image | video
  prompt                 String?
  negativePrompt         String?
  controls               Json
  presetIds              Json
  model                  String?
  profileId              String?
  profileVersion         Int?
  recipeId               String?
  recipeVersion          Int?
  orientation            String?
  outputCount            Int                     @default(1)
  deliveredOutputCount   Int                     @default(0)
  status                 String                  @default("queued") // enum: queued | moderating_input | running | moderating_output | completed | failed | blocked | refunded
  costDreamcoins         Int                     @default(0)
  provider               String?
  sourceType             String                  @default("generator")
  sourceId               String?
  sourceMeta             Json?
  errorCode              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  completedAt            DateTime?
  finishedAt             DateTime?
  version                Int                     @default(1)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  character              Character?              @relation(fields: [characterId], references: [id], onDelete: SetNull)
  referenceSetRevision   ReferenceSetRevision?   @relation(fields: [referenceSetRevisionId], references: [id], onDelete: SetNull)
  look                   CharacterLook?          @relation(fields: [lookId], references: [id], onDelete: SetNull)
  derivedFromJob         GenerationJob?          @relation("GenerationRetry", fields: [derivedFromJobId], references: [id], onDelete: SetNull)
  retryJobs              GenerationJob[]         @relation("GenerationRetry")
  assets                 MediaAsset[]
  events                 GenerationJobEvent[]
  productionItems        ContentProductionItem[]
  referenceCandidates    ReferenceCandidate[]
  generationFeedback     GenerationFeedback[]

  @@unique([userId, idempotencyKey])
  @@unique([sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([derivedFromJobId])
  @@index([status])
  @@index([sourceType])
  @@index([visualProfileId, visualProfileVersion])
  @@index([referenceSetRevisionId])
  @@index([lookId])
  @@index([profileId, profileVersion])
  @@index([recipeId, recipeVersion])
  @@map("generation_jobs")
}

model GenerationJobEvent {
  id        String        @id @default(cuid())
  jobId     String
  type      String
  message   String?
  metadata  Json
  createdAt DateTime      @default(now())
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([type])
  @@map("generation_job_events")
}

model GenerationFeedback {
  id              String               @id @default(cuid())
  feedbackKey     String
  actorId         String
  mediaAssetId    String
  generationJobId String
  dimension       String
  value           String
  revision        Int
  sourceSurface   String
  active          Boolean              @default(true)
  supersedesId    String?
  eventId         String               @unique
  createdAt       DateTime             @default(now())
  actor           User                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  generationJob   GenerationJob        @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  supersedes      GenerationFeedback?  @relation("FeedbackSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    GenerationFeedback[] @relation("FeedbackSupersession")

  @@unique([actorId, mediaAssetId, dimension, revision])
  @@index([actorId, mediaAssetId, dimension, active])
  @@index([generationJobId, createdAt])
  @@map("generation_feedback")
}

model MediaAsset {
  id                     String                             @id @default(cuid())
  ownerId                String
  sourceJobId            String?
  characterId            String?
  type                   String // enum: image | video | voice
  url                    String
  thumbnailUrl           String?
  storageKey             String?                            @unique
  contentType            String?
  width                  Int?
  height                 Int?
  providerAssetId        String?
  sourcePromptHash       String?
  prompt                 String?
  visibility             String                             @default("private") // enum: private | public_pack | unlisted
  safetyStatus           String                             @default("unknown") // enum: unknown | passed | flagged | blocked
  metadata               Json
  liked                  Boolean                            @default(false)
  createdAt              DateTime                           @default(now())
  deletedAt              DateTime?
  owner                  User                               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceJob              GenerationJob?                     @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)
  character              Character?                         @relation("CharacterAssets", fields: [characterId], references: [id], onDelete: SetNull)
  likes                  MediaLike[]
  collections            MediaCollectionItem[]
  productionItems        ContentProductionItem[]
  placements             MediaAssetPlacement[]
  characterImageOf       Character[]                        @relation("CharacterImage")
  templateCoverOf        CharacterTemplate[]                @relation("TemplateCover")
  referenceSnapshots     CharacterVisualReferenceSnapshot[]
  lookReferences         CharacterLook[]
  referenceCandidates    ReferenceCandidate[]
  generationFeedback     GenerationFeedback[]
  draftCharacterProjects CharacterProject[]                 @relation("CharacterProjectDraftImage")
  voiceReferenceProfiles CharacterVoiceProfile[]            @relation("VoiceReferenceAsset")
  voicePreviewProfiles   CharacterVoiceProfile[]            @relation("VoicePreviewAsset")
  voiceClipRequests      VoiceClipRequest[]                 @relation("VoiceClipRequestMedia")
  voiceUsageFacts        VoiceUsageFact[]                   @relation("VoiceUsageMedia")

  @@index([ownerId, type, createdAt])
  @@index([sourceJobId])
  @@index([characterId])
  @@map("media_assets")
}

model ContentProductionBatch {
  id                      String                  @id @default(cuid())
  title                   String
  purpose                 String // enum: character_cover | character_hero | character_chat | identity_calibration | feed | homepage | seo | template_cover | campaign | model_eval
  targetType              String                  @default("none") // enum: character | route_page | campaign | template | none
  targetId                String?
  profileId               String?
  profileVersion          Int?
  recipeId                String?
  recipeVersion           Int?
  presetIds               Json
  orientation             String?
  brief                   String?
  count                   Int                     @default(1)
  totalItems              Int                     @default(0)
