  updatedAt       DateTime  @updatedAt

  @@index([sourceType, sourceId, createdAt])
  @@index([ownerId, reviewAt])
  @@map("decision_records")
}

model ControlPlaneCommand {
  id                  String    @id @default(cuid())
  scope               String
  idempotencyKey      String
  commandType         String
  targetType          String
  targetId            String
  actorId             String
  requestId           String
  requestHash         String
  requestPayload      Json
  expectedVersion     Int?
  approvalId          String?
  retryMode           String    @default("non_replayable")
  status              String    @default("accepted")
  result              Json?
  error               Json?
  needsReconciliation Boolean   @default(false)
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  attemptCount        Int       @default(0)
  maxAttempts         Int       @default(3)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  finishedAt          DateTime?

  @@unique([scope, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@index([targetType, targetId, createdAt])
  @@map("control_plane_commands")
}

