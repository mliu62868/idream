  @@map("companion_engagement_daily")
}

model CharacterFunnelDaily {
  id                           String    @id @default(cuid())
  characterId                  String
  characterContentVersionId    String
  characterReleaseId           String?
  placementId                  String?
  productDay                   DateTime  @db.Date
  metricVersion                Int       @default(1)
  eligibleImpressions          Int       @default(0)
  detailViews                  Int       @default(0)
  firstSuccessfulExchanges     Int       @default(0)
  qceCount                     Int       @default(0)
  relationshipActivations      Int       @default(0)
  sameCharacterD7EligiblePairs Int       @default(0)
  sameCharacterD7Returns       Int       @default(0)
  paidAttributions             Int       @default(0)
  coverageState                String    @default("exact")
  projectionVersion            Int       @default(1)
  latestDataAt                 DateTime?
  sourceEvidence               Json      @default("[]")
  updatedAt                    DateTime  @updatedAt

  @@unique([characterContentVersionId, characterReleaseId, placementId, productDay, metricVersion])
  @@index([characterId, productDay])
  @@map("character_funnel_daily")
}

model CharacterEconomicsFact {
  id                        String   @id @default(cuid())
  characterId               String
  characterContentVersionId String
  characterReleaseId        String
  placementId               String?
  kind                      String
  amountMicros              BigInt
  currency                  String
  authorityType             String
  authorityId               String
  attributionMethod         String
  auditState                String   @default("audited")
  coverageState             String   @default("exact")
  occurredAt                DateTime
  createdAt                 DateTime @default(now())

  @@unique([authorityType, authorityId, kind])
  @@index([characterId, characterContentVersionId, characterReleaseId, placementId, occurredAt], map: "character_economics_facts_characterId_characterContentVersionId")
  @@index([auditState, coverageState, occurredAt], map: "character_economics_facts_auditState_coverageState_occurredAt_i")
  @@map("character_economics_facts")
}

model MetricSnapshot {
  id                  String    @id @default(cuid())
  metricKey           String
  definitionVersion   Int
  windowStart         DateTime
  windowEnd           DateTime
  asOf                DateTime
  numeratorValue      Float?
  denominatorValue    Float?
  value               Float?
  sampleSize          Int
  matureSampleSize    Int
  immatureSampleSize  Int
  maturity            String
  qualityState        String
  publicationStatus   String
  latestDataAt        DateTime?
  definitionQueryHash String
  qualityEvidence     Json
  createdAt           DateTime  @default(now())

  @@unique([metricKey, definitionVersion, windowStart, windowEnd, asOf])
  @@index([qualityState, asOf])
  @@map("metric_snapshots")
}

model DataQualityCheck {
  id           String    @id @default(cuid())
  checkKey     String
  checkVersion Int       @default(1)
  status       String
  metricKeys   Json
  observed     Json
  threshold    Json
  evidence     Json
  windowStart  DateTime?
  windowEnd    DateTime?
  checkedAt    DateTime  @default(now())

  @@index([checkKey, checkedAt])
  @@index([status, checkedAt])
  @@map("data_quality_checks")
}

model MetricBackfillRun {
  id             String    @id @default(cuid())
  source         String
  status         String    @default("pending")
  dryRun         Boolean   @default(true)
  cursor         String?
  batchSize      Int
  scannedCount   Int       @default(0)
  appliedCount   Int       @default(0)
  skippedCount   Int       @default(0)
  mismatchCount  Int       @default(0)
  coverage       Float?
  validFrom      DateTime?
  beforeSnapshot Json
  afterSnapshot  Json
  mismatchReport Json
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([source, status, updatedAt])
  @@map("metric_backfill_runs")
}

model AiUsageFact {
  id                   String   @id @default(cuid())
  source               String
  requestId            String?
  attemptId            String?
  transportExecutionId String?
  userId               String?
  characterId          String?
  releaseId            String?
  provider             String
  model                String
  usage                Json
  latencyMs            Int?
  costMicros           BigInt?
  pricingVersion       String?
  sourceService        String   @default("main")
  sourceEventId        String?
  environment          String   @default("local")
  dataClass            String   @default("customer")
  trustClass           String   @default("canonical")
  actorIsInternal      Boolean  @default(false)
  occurredAt           DateTime
  createdAt            DateTime @default(now())

  @@unique([sourceService, sourceEventId])
  @@index([requestId, occurredAt])
  @@index([provider, model, occurredAt])
  @@index([characterId, releaseId, occurredAt])
  @@map("ai_usage_facts")
}
