CHAT_AGENT_HOST=127.0.0.1
CHAT_AGENT_PORT=3101
DSH_AGENT_TOKEN=replace-with-the-same-secret-used-by-chat

DSH_IGREP_CANONICAL_ROOT=/var/lib/idream/chat-agent-memory
DSH_IGREP_PRIVATE_ROOT=/var/lib/idream/chat-agent-private
DSH_IGREP_COMMAND=/opt/idream/igrep-profile/bin/igrep
DSH_IGREP_PLUGIN_URL=/opt/idream/igrep-profile/node_modules/@igrep/dsh-plugin/index.mjs
DSH_BOOTSTRAP_STATE_PATH=/opt/idream/igrep-profile/idream-companion-bootstrap.json

DSH_PROVIDER_API_KEY=replace-with-provider-key
DSH_READY_PROVIDER=openrouter
DSH_READY_MODEL=deepseek/deepseek-chat
DSH_READY_BASE_URL=https://openrouter.ai/api/v1
DSH_OPENROUTER_PROVIDER_ONLY=DeepSeek
DSH_MAX_STEPS=8
