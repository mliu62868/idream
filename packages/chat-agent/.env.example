CHAT_AGENT_HOST=127.0.0.1
CHAT_AGENT_PORT=3101
DSH_AGENT_TOKEN=replace-with-the-same-secret-used-by-chat

DSH_IGREP_CANONICAL_ROOT=../../data/chat-agent-memory
DSH_IGREP_PRIVATE_ROOT=../../data/chat-agent-private
DSH_IGREP_SHADOW_ROOT=../../data/chat-agent-shadow
DSH_IGREP_COMMAND=/absolute/path/to/igrep
DSH_IGREP_PLUGIN_URL=/absolute/path/to/profile/node_modules/@igrep/dsh-plugin/index.mjs
DSH_BOOTSTRAP_STATE_PATH=/absolute/path/to/idream-companion-bootstrap.json
IGREP_LLM_URL=http://127.0.0.1:8061/v1
IGREP_LLM_MODEL=replace-with-maintenance-model
IGREP_LLM_API_KEY=replace-with-maintenance-provider-key

DSH_PROVIDER_API_KEY=replace-with-provider-key
DSH_READY_PROVIDER=openrouter
DSH_READY_MODEL=deepseek/deepseek-chat
DSH_READY_BASE_URL=https://openrouter.ai/api/v1
DSH_OPENROUTER_PROVIDER_ONLY=DeepSeek
DSH_MAX_STEPS=8
DSH_MAX_NORMAL_AGENTS=4
DSH_MAX_PRIVATE_AGENTS=4
