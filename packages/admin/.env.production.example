# iDream admin-web production environment template.
# Store filled values in the deployment secret manager.

APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
PORT=3001

MAIN_WEB_URL=https://ourdream.ai
BETTER_AUTH_URL=https://ourdream.ai
BETTER_AUTH_SECRET=replace-with-random-32-byte-secret
INTERNAL_TOKEN=replace-with-random-internal-token
ADMIN_BFF_SIGNING_SECRET=replace-with-random-admin-bff-secret

# Error capture. DSN values are public identifiers.
NEXT_PUBLIC_APP_ENV=production
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_RELEASE=idream@replace-with-git-sha
NEXT_PUBLIC_SENTRY_RELEASE=idream@replace-with-git-sha
