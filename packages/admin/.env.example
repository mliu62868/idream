# Admin Console service. Use the same database and auth secrets as packages/main.
#
# Local dev login (APP_ENV != production only): open http://localhost:3001/admin
# and use a built-in account below — no signup needed. Requires the dev DB to be
# seeded first: `cd packages/main && npm run db:seed`.
#   admin   / admin123     -> role: admin   (full access)
#   support / support123   -> role: support (read-only + tickets)
# Accounts live in packages/main/src/server/admin/dev-login-accounts.ts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/idream

BETTER_AUTH_SECRET=replace-with-at-least-32-characters
INTERNAL_TOKEN=replace-with-at-least-16-characters
CRON_SECRET=replace-with-at-least-16-characters

APP_ENV=development
LOG_LEVEL=info

# HTTP port for next start (admin-web)
PORT=3001

# Keep this aligned with the public product origin that issues auth sessions.
BETTER_AUTH_URL=http://localhost:3000
# Used by the admin image proxy for seeded/public product artwork.
MAIN_WEB_URL=http://localhost:3000
# MUST match main. Production Admin requests fail closed without this service HMAC.
ADMIN_BFF_SIGNING_SECRET=replace-with-at-least-32-characters

# Global fail-closed release controls take precedence over every domain flag.
ADMIN_V2_READ_KILL_SWITCH=false
ADMIN_V2_WRITE_KILL_SWITCH=false

# Module-level read cutover controls. Omit or use canonical_v2 for normal
# operation. compatibility_http requires the paired URL to expose the exact
# same /api/v2/admin contract (typically a previous compatible main deployment).
# deployment_rollback deliberately returns a typed 503 until the Admin deploy is
# rolled back. Legacy v1 DTO paths are not accepted as v2 read authorities.
ADMIN_CHARACTER_READ_AUTHORITY=canonical_v2
# ADMIN_CHARACTER_COMPATIBILITY_READ_URL=https://previous-main.internal
ADMIN_CREATIVE_READ_AUTHORITY=canonical_v2
# ADMIN_CREATIVE_COMPATIBILITY_READ_URL=https://previous-main.internal
ADMIN_INCIDENT_READ_AUTHORITY=canonical_v2
# ADMIN_INCIDENT_COMPATIBILITY_READ_URL=https://previous-main.internal
ADMIN_CASE_READ_AUTHORITY=canonical_v2
# ADMIN_CASE_COMPATIBILITY_READ_URL=https://previous-main.internal
ADMIN_TODAY_READ_AUTHORITY=canonical_v2
# ADMIN_TODAY_COMPATIBILITY_READ_URL=https://previous-main.internal

REDIS_URL=redis://127.0.0.1:6379/0
# MUST be identical across main / chat / gen / admin — a mismatch silently drops
# every cross-service queue event. Use idream:${APP_ENV} (dev: idream:development).
BULLMQ_PREFIX=idream:development

CHAT_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock
MODERATION_PROVIDER=mock
PAYMENT_PROVIDER=mock
BLOB_PROVIDER=mock
BLOB_ROOT=data/blob
AGE_VERIFICATION_PROVIDER=mock
