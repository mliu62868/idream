{
  "name": "@idream/admin",
  "version": "0.3.1",
  "private": true,
  "description": "iDream Admin Console — independently deployed internal control-plane service.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node ../../scripts/prepare-next-standalone.mjs packages/admin",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
