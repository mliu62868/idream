{
  "name": "idream",
  "version": "0.3.1",
  "private": true,
  "description": "iDream — AI companion platform (monorepo). main-web + chat service + gen workers, split by execution-time SLA.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "esbuild",
    "msgpackr-extract",
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "check": "bun run lint && bun run typecheck && bun run build",
    "dev": "bun run --filter @idream/main dev",
    "dev:admin": "bun run --filter @idream/admin dev",
    "pm2:start": "node scripts/start-pm2-ecosystem.cjs",
    "pm2:start:production": "node scripts/start-pm2-ecosystem.cjs production",
    "pm2:stop": "node scripts/start-pm2-ecosystem.cjs current stop",
    "pm2:restart": "node scripts/start-pm2-ecosystem.cjs current restart",
    "pm2:restart:production": "node scripts/start-pm2-ecosystem.cjs production restart",
    "pm2:reload": "node scripts/start-pm2-ecosystem.cjs current reload",
    "pm2:reload:production": "node scripts/start-pm2-ecosystem.cjs production reload",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "source:revision": "node scripts/source-revision.cjs",
    "test:pm2-config": "node --test scripts/source-revision.test.cjs scripts/ecosystem-config.test.cjs scripts/check-gen-image-worker-ownership.test.cjs scripts/recover-gen-worker-orphans.test.cjs scripts/launch-operator-docs.test.cjs packages/main/scripts/start-development.test.cjs packages/admin/scripts/start-development.test.cjs",
    "probe:gen-image-ownership": "node scripts/check-gen-image-worker-ownership.cjs --mode steady",
    "generation:quiesce-for-orphan-recovery": "node scripts/start-pm2-ecosystem.cjs current quiesce",
    "generation:plan-orphan-recovery": "node scripts/recover-gen-worker-orphans.cjs plan",
    "generation:apply-orphan-recovery": "node scripts/recover-gen-worker-orphans.cjs apply",
    "check:launch": "packages/main/node_modules/.bin/tsx packages/main/src/server/launch-readiness.ts",
    "check:launch:direct": "packages/main/node_modules/.bin/tsx packages/main/src/server/launch-readiness.ts",
    "recovery:rehearse": "bun run --cwd packages/main recovery:rehearse",
    "launch:probe:age": "bun run --filter @idream/main probe:age",
    "launch:probe:blob": "bun run --filter @idream/main probe:blob",
    "launch:probe:chat": "node --env-file=packages/main/.env --env-file=packages/chat/.env packages/main/node_modules/.bin/tsx packages/main/src/server/probe-chat-model.ts",
    "launch:probe:chat-service": "bun run --filter @idream/main probe:chat-service",
    "launch:probe:catalog": "bun run --filter @idream/main probe:catalog",
    "launch:probe:character-consistency": "bun run --filter @idream/gen probe:character-consistency",
    "launch:probe:generation-model-candidates": "bun run --filter @idream/main probe:generation-model-candidates",
    "launch:probe:generation-persistence": "bun run --filter @idream/main probe:generation-persistence",
    "launch:probe:image:local": "node scripts/run-local-image-probe.mjs",
    "launch:probe:pipeline": "node scripts/run-internal-pipeline-probes.mjs",
    "launch:probe:redcraft-comfyui": "bun run --filter @idream/gen probe:redcraft-comfyui",
    "launch:probe:redcraft-consistency:local": "node scripts/run-local-redcraft-consistency-probe.mjs",
    "launch:probe:redcraft-image:local": "node scripts/run-local-redcraft-image-probe.mjs",
    "launch:prepare:voice:kokoro": "node scripts/prepare-omlx-kokoro.mjs",
    "launch:probe:voice:local": "node scripts/run-local-voice-probe.mjs",
    "voice:fish:start": "node scripts/start-fish-audio.cjs",
    "voice:fish:prepare-system": "node scripts/prepare-fish-system-voice.mjs",
    "test:voice:fish": "PYTHONPATH=/Applications/oMLX.app/Contents/Resources:/Applications/oMLX.app/Contents/Resources/Python/framework-mlx-base/lib/python3.11/site-packages /Applications/oMLX.app/Contents/Resources/Python/cpython-3.11/bin/python3.11 -m unittest scripts.test_fish_audio_gateway",
    "voice:pocket:start": "node scripts/start-pocket-tts.cjs",
    "test:voice:pocket:omlx": "uv run --with fastapi --with httpx --with python-multipart --with uvicorn python -m scripts.test_pocket_tts_omlx_gateway",
    "launch:probe:payment": "bun run --filter @idream/main probe:payment",
    "launch:probe:product-config": "bun run --filter @idream/main probe:product-config",
    "launch:probe:safety": "bun run --filter @idream/main probe:safety",
    "launch:probe:sentry:main": "bun run --filter @idream/main probe:sentry",
    "launch:probe:sentry:admin": "bun run --filter @idream/admin probe:sentry",
    "launch:probe:sentry:chat": "bun run --filter @idream/chat probe:sentry",
    "launch:probe:sentry:gen": "bun run --filter @idream/gen probe:sentry",
    "launch:probe:video": "bun run --filter @idream/gen probe:video",
    "launch:probe:web-surface": "bun run --filter @idream/main probe:web-surface",
    "launch:probe:voice": "bun run --filter @idream/main probe:voice",
    "launch:secrets": "node scripts/generate-launch-secrets.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  }
}
